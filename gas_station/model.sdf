<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="Gas Station">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>12 12 6</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gas_station/meshes/gas_station.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://gas_station/materials/textures/GasStation_Diffuse.png</albedo_map>
              <normal_map>model://gas_station/materials/textures/GasStation_Normal.png</normal_map>
              <metalness_map>model://gas_station/materials/textures/GasStation_Spec.png</metalness_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
